# ==============================================================================
# Master Environment Configuration Template (.env.example)
# KromaCommerce Distributed Microservices & Consolidated Free Tier Architecture
# ==============================================================================

# Node Environment
NODE_ENV=development

# API Gateway & Network Ports
PORT=8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Execution Mode: set 'true' for single 512MB container deployment (Render/Koyeb)
CONSOLIDATED_MODE=true

# Downstream Microservices Internal URLs (for Distributed Docker Mode)
AUTH_SERVICE_URL=http://localhost:8001
CATALOG_SERVICE_URL=http://localhost:8002
ORDER_SERVICE_URL=http://localhost:8003
SCRAPER_SERVICE_URL=http://localhost:8004

# PostgreSQL Database (Neon / Supabase Serverless with PgBouncer Pooling)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kromacommerce?sslmode=disable"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kromacommerce?sslmode=disable"

# JWT Security Secrets & Expiration
JWT_ACCESS_SECRET="generate-super-secure-access-secret-32-chars-minimum"
JWT_REFRESH_SECRET="generate-super-secure-refresh-secret-32-chars-minimum"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Payment Gateway Configuration
# Strategy Pattern: 'mock' (for deterministic CI/E2E testing) or 'stripe'
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY="sk_test_placeholder_key"
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_secret"

# OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID="mock-google-client-id"
GOOGLE_CLIENT_SECRET="mock-google-client-secret"
GITHUB_CLIENT_ID="mock-github-client-id"
GITHUB_CLIENT_SECRET="mock-github-client-secret"
